---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
const source = path.resolve(process.cwd(), 'src/content/home.html');
const html = fs.existsSync(source) ? fs.readFileSync(source, 'utf8') : '<p>Skyodor</p>';
const body = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? html;
---
<Layout title="Skyodor">
  <div class="astro-v03-shell" set:html={body}></div>
</Layout>
