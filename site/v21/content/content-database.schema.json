{
  "$id": "schemas/content-database.schema.json",
  "title": "Skyodor Content Database",
  "type": "object",
  "required": ["schema_version", "database_name", "source", "data_contract", "entities", "relationships", "quality_control"],
  "properties": {
    "schema_version": {"type": "string"},
    "database_name": {"type": "string"},
    "database_purpose": {"type": "string"},
    "locale": {"type": "string"},
    "currency": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["domain", "baseline_path", "branch", "extraction_status", "rules"],
      "properties": {
        "domain": {"type": "string"},
        "baseline_path": {"type": "string"},
        "branch": {"type": "string"},
        "extraction_status": {"type": "string"},
        "rules": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "data_contract": {"type": "object", "additionalProperties": true},
    "entities": {"type": "object", "additionalProperties": true},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "type", "to"],
        "properties": {
          "from": {"type": "string"},
          "type": {"type": "string"},
          "to": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "quality_control": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
